{
    "name":  "digital-business-card",
    "version":  "1.0.0",
    "private":  true,
    "description":  "NestJS + Prisma + GraphQL digital business card",
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json",
                    "start":  "node dist/main.js",
                    "start:dev":  "node --env-file=.env --import tsx --watch src/main.ts",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:deploy":  "prisma migrate deploy",
                    "db:seed":  "prisma db seed",
                    "test":  "jest --runInBand",
                    "test:smoke":  "node scripts/smoke.mjs",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "test:e2e":  "jest --config jest.e2e.config.cjs --runInBand"
                },
    "prisma":  {
                   "seed":  "node prisma/seed.js"
               },
    "dependencies":  {
                         "@apollo/server":  "5.5.1",
                         "@as-integrations/express5":  "1.1.2",
                         "@nestjs/apollo":  "13.4.5",
                         "@nestjs/common":  "11.2.7",
                         "@nestjs/core":  "11.2.7",
                         "@nestjs/graphql":  "13.4.5",
                         "@nestjs/platform-express":  "11.2.7",
                         "@prisma/client":  "6.19.3",
                         "graphql":  "16.14.0",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2",
                         "prisma":  "6.19.3"
                     },
    "devDependencies":  {
                            "@types/jest":  "29.5.14",
                            "@types/node":  "22.15.30",
                            "jest":  "29.7.0",
                            "ts-jest":  "29.4.0",
                            "tsx":  "4.20.3",
                            "typescript":  "5.9.3"
                        },
    "overrides":  {
                      "@graphql-tools/utils":  "12.0.2",
                      "deepmerge-ts":  "8.0.2"
                  }
}